---
import "../styles.css";
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#17191e" />
    <meta
      name="description"
      content="Pablo Estigarribia, desarrollador frontend en Buenos Aires. React, Astro y Tailwind. Proyectos, notas y contacto."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Pablo Estigarribia · Frontend" />
    <meta
      property="og:description"
      content="Desarrollador frontend junior en Buenos Aires. Proyectos reales para clientes, comunidad y uso propio."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>Pablo Estigarribia · Frontend</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
